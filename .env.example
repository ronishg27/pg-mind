# Read-only connection (REQUIRED — the server will not start without this)
# Role: pgmind_readonly
QUERY_DATABASE_URL=postgresql://pgmind_readonly:YOUR_PASSWORD@localhost:5433/pgmind_dev

# Write connection (OPTIONAL — write operations are unavailable if not configured)
# Role: pgmind_writer
WRITE_DATABASE_URL=postgresql://pgmind_writer:YOUR_PASSWORD@localhost:5433/pgmind_dev

# DATABASE_NAME is used by config/index.ts (defaults to "pgmind_dev") and by some
# development test scripts. DATABASE_URL is used only by development test scripts,
# not by the MCP server itself.
# DATABASE_NAME=pgmind_dev
# DATABASE_URL=postgresql://pgmind:YOUR_PASSWORD@localhost:5433/pgmind_dev
