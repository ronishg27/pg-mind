# Read-only connection (REQUIRED — the server will not start without this)
# Role: pgmind_readonly
QUERY_DATABASE_URL=postgresql://pgmind_readonly:YOUR_PASSWORD@localhost:5433/pgmind_dev

# Write connection (OPTIONAL — write operations are unavailable if not configured)
# Role: pgmind_writer
WRITE_DATABASE_URL=postgresql://pgmind_writer:YOUR_PASSWORD@localhost:5433/pgmind_dev

# Database identity verification (REQUIRED for startup validation)
EXPECTED_DATABASE=pgmind_dev
EXPECTED_READ_ROLE=pgmind_readonly
EXPECTED_WRITE_ROLE=pgmind_writer
# Optional: stronger identity binding (host/port)
# EXPECTED_HOST=localhost
# EXPECTED_PORT=5433

# Pool configuration
POOL_MAX_READ=10
POOL_MAX_WRITE=10
POOL_CONNECTION_TIMEOUT_MS=5000
POOL_IDLE_TIMEOUT_MS=30000

# Transaction timeouts (milliseconds)
STATEMENT_TIMEOUT_MS=10000
LOCK_TIMEOUT_MS=5000
IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Application name for PostgreSQL connection identification
APPLICATION_NAME=pgmind

# Legacy variables (used by some development test scripts)
# DATABASE_NAME=pgmind_dev
# DATABASE_URL=postgresql://pgmind:YOUR_PASSWORD@localhost:5433/pgmind_dev