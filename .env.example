# Read-only connection (REQUIRED — the server will not start without this)
# Role: querymind_readonly
QUERY_DATABASE_URL=postgresql://querymind_readonly:YOUR_PASSWORD@localhost:5433/querymind_dev

# Write connection (OPTIONAL — write operations are unavailable if not configured)
# Role: querymind_writer
WRITE_DATABASE_URL=postgresql://querymind_writer:YOUR_PASSWORD@localhost:5433/querymind_dev

# DATABASE_NAME is used by config/index.ts (defaults to "querymind_dev") and by some
# development test scripts. DATABASE_URL is used only by development test scripts,
# not by the MCP server itself.
# DATABASE_NAME=querymind_dev
# DATABASE_URL=postgresql://querymind:YOUR_PASSWORD@localhost:5433/querymind_dev
